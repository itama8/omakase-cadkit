{
  "name": "omakase-cadkit",
  "version": "0.1.0-alpha.3.1",
  "private": true,
  "description": "View, inspect and lint DWG/DXF drawings for civil infrastructure.",
  "type": "module",
  "bin": {
    "omakase-cadkit": "bin/omakase-cadkit.mjs",
    "drawkit": "bin/drawkit.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build:lib": "tsc -p tsconfig.build.json",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:viewer": "esbuild viewer/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=viewer/dist/viewer.js && esbuild viewer/stroke-worker.ts --bundle --format=esm --target=es2022 --outfile=viewer/dist/stroke-worker.js",
    "build": "npm run build:lib && npm run build:sidecar && npm run build:viewer",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "fixtures": "uv run --quiet --with ezdxf --python 3.13 python -I fixtures/make_fixtures.py fixtures",
    "setup": "node scripts/setup.mjs",
    "bundle": "node scripts/bundle.mjs",
    "smoke": "node scripts/smoke.mjs",
    "consumer": "npm --prefix examples/library-consumer install --no-audit --no-fund --silent && npm --prefix examples/library-consumer run typecheck --silent && npm --prefix examples/library-consumer start --silent"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itama8/omakase-cadkit.git"
  },
  "bugs": {
    "url": "https://github.com/itama8/omakase-cadkit/issues"
  },
  "homepage": "https://github.com/itama8/omakase-cadkit#readme",
  "files": [
    "dist/",
    "bin/omakase-cadkit.mjs",
    "bin/drawkit.mjs",
    "sidecar/*.cs",
    "sidecar/OmakaseCadkitSidecar.csproj",
    "viewer/index.html",
    "viewer/style.css",
    "viewer/favicon.svg",
    "viewer/fonts/",
    "viewer/dist/",
    "fixtures/make_fixtures.py",
    "fixtures/omakase-cadkit.json",
    "scripts/build-sidecar.mjs",
    "scripts/setup.mjs",
    "scripts/shot.mjs",
    "scripts/smoke.mjs",
    "scripts/viewer-check.js",
    "skills/",
    "docs/",
    "licenses/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ]
}
