{
  "name": "omakase-cadkit",
  "version": "0.1.0",
  "private": true,
  "description": "View, inspect and lint DWG/DXF drawings for civil infrastructure.",
  "type": "module",
  "bin": {
    "omakase-cadkit": "bin/omakase-cadkit.mjs",
    "drawkit": "bin/drawkit.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:viewer": "esbuild viewer/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=viewer/dist/viewer.js",
    "build": "npm run build:sidecar && npm run build:viewer",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "fixtures": "uv run --quiet --with ezdxf --python 3.13 python -I fixtures/make_fixtures.py fixtures",
    "setup": "node scripts/setup.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itama8/omakase-cadkit.git"
  },
  "bugs": {
    "url": "https://github.com/itama8/omakase-cadkit/issues"
  },
  "homepage": "https://github.com/itama8/omakase-cadkit#readme"
}
